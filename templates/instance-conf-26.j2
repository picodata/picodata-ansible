{{ ansible_managed | comment }}

cluster:
  name: '{{ cluster_name }}'
  default_bucket_count: {{ default_bucket_count | default(30000) }}
  shredding: {{ shredding | to_json }}

  tier:
{% for name, params in tiers.items() %}
    {{ name }}:
      replication_factor: {{ params.replication_factor | default(1) }}
      can_vote: {{ params.can_vote | default(true) | to_json }}
{% if params.bucket_count is defined %}
      bucket_count: {{ params.bucket_count }}
{% endif %}
{% if picodata_version is version('26.2', '>=') %}
{% if params.wal_mode is defined %}
      wal_mode: {{ params.wal_mode }}
{% endif %}
{% if params.experimental_sharding_implementation is defined %}
      experimental_sharding_implementation: {{ params.experimental_sharding_implementation | to_json }}
{% endif %}
{% if params.replication_mode is defined %}
      replication_mode: {{ params.replication_mode }}
{% endif %}
{% endif %}

{% endfor %}

instance:
  admin_socket: '{{ run_dir }}/{{ cluster_name }}/{{ instance_name }}.sock'
  instance_dir: '{{ data_dir }}/{{ cluster_name }}/{{ instance_name }}'
  backup_dir: '{{ backup_dir }}/{{ cluster_name }}/{{ instance_name }}'
  share_dir: '{{ share_dir }}/{{ cluster_name }}'
{% if picodata_version is version('26.2', '>=') %}
  wal_dir: '{{ tier.value.wal_dir | default(wal_dir) }}/{{ cluster_name }}/{{ instance_name }}'
{% endif %}
{% if autonames |bool == false %}
  name: '{{ instance_name }}'
{% endif %}

  tier: '{{ tier.key }}'
  peer: {{ peer_list }}
  failure_domain: { {% if fd_uniq_per_instance| bool == true %}'I': '{{ instance_name }}'{% else %}{{ fd }}{% endif %} }

  iproto:
    enabled: true
    listen: '0.0.0.0:{{ list_bin[instance_index | int] | regex_search('.*:([0-9]+)', '\\1') | list | last }}'
    advertise: '{{ list_bin[instance_index | int] }}'
    tls:
{% if iproto_tls | bool == true %}
      enabled: true
      cert_file: {{ cert_dir }}/{{ cluster_name }}/iproto/{{ iproto_cert_file | basename }}
      key_file: {{ cert_dir }}/{{ cluster_name }}/iproto/{{ iproto_key_file | basename }}
      ca_file: {{ cert_dir }}/{{ cluster_name }}/iproto/{{ iproto_ca_file | basename }}
{% else %}
      enabled: false
{% endif %}

  pgproto:
    enabled: {{ pg_enable | to_json }}
    listen: '0.0.0.0:{{ list_pg[instance_index | int] | regex_search('.*:([0-9]+)', '\\1') | list | last }}'
    advertise: '{{ list_pg[instance_index | int] }}'
    tls:
{% if pg_ssl | bool == true %}
      enabled: true
      cert_file: '{{ cert_dir }}/{{ cluster_name }}/pg/{{ pg_cert_file | basename }}'
      key_file: '{{ cert_dir }}/{{ cluster_name }}/pg/{{ pg_key_file | basename }}'
      ca_file: '{{ cert_dir }}/{{ cluster_name }}/pg/{{ pg_ca_file | basename }}'
{% else %}
      enabled: false
{% endif %}

  http:
    enabled: true
    listen: '0.0.0.0:{{ list_http[instance_index | int] | regex_search('.*:([0-9]+)', '\\1') | list | last }}'
    advertise: '{{ list_http[instance_index | int] }}'
    tls:
{% if https | bool == true %}
      enabled: true
      cert_file: {{ cert_dir }}/{{ cluster_name }}/https/{{ https_cert_file | basename }}
      key_file: {{ cert_dir }}/{{ cluster_name }}/https/{{ https_key_file | basename }}
{% if https_password_file is defined and https_password_file != '' %}
      password_file: '{{ cert_dir }}/{{ cluster_name }}/https/{{ https_password_file | basename }}'
{% endif %}
{% else %}
      enabled: false
{% endif %}
    kubernetes_probes: true

  log:
    level: {{ tier.value.log_level | default(log_level) }}
{% if log_to == "file" %}
    destination: '{{ log_dir }}/{{ cluster_name }}/{{ instance_name }}.log'
{% elif log_to == "pipe" and log_pipe_command is defined %}
    destination: 'pipe:{{ log_pipe_command }}'
{% endif %}
    format: '{{ log_format }}'
{% if audit | bool == true %}
{% if audit_to == "file" %}
  audit: '{{ log_dir }}/{{ cluster_name }}/audit-{{ instance_name }}.log'
{% elif audit_to == "pipe" and audit_pipe_command is defined %}
  audit: 'pipe:{{ audit_pipe_command }}'
{% else %}
  audit: '{{ audit_to }}:'
{% endif %}
{% endif %}
{% if config_tier != {} %}
  {{ config_tier | to_nice_yaml(indent=2) | indent(width=2) }}
{% endif %}
{% if ldap is defined and picodata_version is version('26.2', '>=') %}
  ldap:
    {{ ldap | to_nice_yaml(indent=2) | indent(width=4) }}
{% endif %}
{% if picodata_version is version('26.1', '>=') %}
{% if plugins is mapping %}
{% set plugin_config = {} %}
{% for plugin_name, plugin in plugins.items() %}
{% if plugin.services is mapping %}
{% for service_name, service in plugin.services.items() %}
{% if service.tiers is defined %}
{% for service_tier in service.tiers %}
{% if service_tier is mapping %}
{% set service_tier_name = (service_tier | dict2items)[0].key %}
{% set service_tier_config = (service_tier | dict2items)[0].value %}
{% else %}
{% set service_tier_name = service_tier %}
{% set service_tier_config = none %}
{% endif %}
{% if tier.key == service_tier_name and service_tier_config %}
{% if plugin_name not in plugin_config %}
{% set _ = plugin_config.update({plugin_name: {}}) %}
{% endif %}
{% set _ = plugin_config[plugin_name].update({service_name: service_tier_config}) %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% if plugin_config %}
  plugin:
{% for plugin_name, services in plugin_config.items() %}
    {{ plugin_name }}:
      service:
        {{ services
          | to_nice_yaml(indent=2)
          | indent(width=8)
          | replace ("<INSTANCE_NUM>", "%02d"|format(instance_index|int ))
          | replace ("<INSTANCE_NUM3>", "%03d"|format(instance_index|int))
          | replace ("<INSTANCE_ADDR>", "%s"|format(listen_address))
        }}
{% endfor %}
{% endif %}
{% endif %}
{% endif %}
