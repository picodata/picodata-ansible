{{ ansible_managed | comment }}

[Service]
{% if tier.value.extra_vars is defined %}
{% for param, val in tier.value.extra_vars.items() %}
{% if val | type_debug == 'list' %}
Environment={{ param }}='{{ val[instance_id|int -1] }}'
{% else %}
Environment={{ param }}='{{ val | replace ("<INSTANCE_NUM>", "%02d"|format(instance_index|int) ) | replace ("<INSTANCE_NUM3>", "%03d"|format(instance_index|int) ) | replace ("<INSTANCE_ADDR>", "%s"|format(listen_address)) }}'
{% endif %}
{% endfor %}
{% endif %}
